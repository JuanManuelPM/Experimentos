{
  "manifest_version": 3,
  "name": "Universal UI",
  "version": "0.3.0",
  "description": "Personalización y lanzador de WhatsApp y ChatGPT en Firefox.",
  "browser_specific_settings": {
    "gecko": {
      "id": "universal-ui@juanmanuelpm",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "action": {
    "default_title": "Universal UI (Alt+Shift+U)",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "Abrir Universal UI"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "optional_host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://web.whatsapp.com/*",
    "https://es.wikipedia.org/*",
    "https://en.wikipedia.org/*"
  ]
}
