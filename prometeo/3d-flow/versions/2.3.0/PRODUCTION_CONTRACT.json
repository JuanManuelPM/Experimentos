{
  "version": "2.3.0",
  "schema": "prometeo.3d.production-contract/v2.2",
  "avatar": {
    "state": "ZERO_APPROVED_VISUAL_BASE",
    "noFixedMethod": true,
    "compareDistinctViableRoutes": 2,
    "applies": "all visible actors required by brief; do not force actors",
    "requiredSteps": [
      "AV_ROLE",
      "AV_BUDGET",
      "AV_REF",
      "AV_OPEN",
      "AV_TOOL",
      "AV_DESIGN",
      "AV_BODY",
      "AV_FACE",
      "AV_HANDS",
      "AV_HAIR",
      "AV_CLOTH",
      "AV_MATERIAL",
      "AV_TOPO",
      "AV_RIG",
      "AV_EXPR",
      "AV_LOOKDEV",
      "AV_ITERATE",
      "AV_CAST",
      "AV_AXIS",
      "AV_ROUTE",
      "AV_CLIPS",
      "AV_ALL_MOTION",
      "AV_CONTACT",
      "AV_SAVE",
      "AV_REVIEW"
    ],
    "lookdev": [
      "FRONT",
      "PROFILE",
      "BACK",
      "THREE_QUARTER",
      "FACE_IF_CLOSEUP",
      "TARGET_SHOT",
      "ACTION_IF_ANIMATED"
    ],
    "artifacts": [
      "editable source",
      "asset/license hash",
      "cast roster",
      "lookdev frames",
      "variant comparisons",
      "AVATAR_EXPERIMENT_RECEIPT"
    ],
    "promotion": "HUMAN_APPROVED_APPEARANCE_AND_SECOND_CONSUMER_FOR_SHARED_STANDARD",
    "prohibitFinishedPrimitiveHumanoids": true,
    "eligibleArtRoutes": [
      "REAL_EDITABLE_MODELING",
      "LICENSED_ASSET_DOWNLOAD_IMPORT_ADAPTATION",
      "COLLAGE_2D_2_5D",
      "ANIMATED_SPRITESHEETS",
      "HYBRID_2D_3D",
      "OTHER_ROLE_APPROPRIATE"
    ],
    "preferRealImportedOrAuthoredAsset": true,
    "noMandatoryAvatarPipeline": true
  },
  "motion": {
    "scope": "ALL_LOCOMOTING_ACTORS_AND_ROUTES",
    "thresholdDot": 0.8,
    "minSpeedMps": 0.05,
    "maxSampleGapSeconds": 0.12,
    "minMovingSamplesPerRoute": 3,
    "exceptions": [
      "BACKPEDAL",
      "STRAFE"
    ],
    "artifact": "CAST_MOTION_QA"
  },
  "ui": {
    "defaultMode": "PRESENTATION",
    "maxPersistentViewportFraction": 0.12,
    "maxFocalOverlap": 0,
    "touchTargetCSSPx": 44,
    "viewports": [
      [
        360,
        640
      ],
      [
        412,
        915
      ],
      [
        915,
        412
      ]
    ],
    "modal": "EXPLICIT_USER_ACTION_ONLY",
    "artifact": "UI_TOUCH_QA"
  },
  "touch": {
    "freeLook": "SWIPE_RIGHT_LOOK_RIGHT_UP_LOOK_UP",
    "orbit": "GRAB_WORLD_FOLLOWS_FINGER",
    "checks": [
      "four directions",
      "pinch",
      "pan",
      "pointercancel",
      "lostpointercapture",
      "tap versus drag",
      "UI exclusion",
      "mode switch pose",
      "reset",
      "resize"
    ]
  },
  "latentRisks": [
    "BOOT_ASSETS",
    "DEPTH_PARALLAX",
    "SCALE_CLOSURE",
    "COLLISIONS_CONTACT",
    "CAMERA_CLIPPING",
    "ANIMATION_TRANSITIONS",
    "RESIZE_SAFE_AREA",
    "CONTEXT_RESTORE",
    "AUDIO_AUTOPLAY",
    "FPS_MEMORY",
    "RESET_RESUME"
  ],
  "evidencePolicy": "PASS with actual evidence, FAIL, NOT_RUN, justified N/A; no artistic veto on full attempt",
  "qualityFinish": {
    "required": false,
    "role": "HISTORICAL_COMPARISON_IF_USER_REQUESTS",
    "postProductionArtisticTestsRequired": false,
    "noAutomaticArtRepair": true,
    "doesNotBlockCandidate": true,
    "humanJudgmentOnly": true,
    "artistMustPreventAtEarlyDesign": true
  },
  "preventiveQuality": {
    "priority": "HIGHEST",
    "beforeProduction": true,
    "afterProductionArtisticErrorTestingRequired": false,
    "preproductionComparison": "TWO_DISTINCT_VIABLE_METHODS_WHEN_HIGH_IMPACT",
    "methods": "REFERENCE_RESEARCH_REAL_BYTES_ART_AUTHORING_ROUTE_SELECTION",
    "humanReview": "AFTER_DELIVERY_BETWEEN_WAVES",
    "calibrar": "MODIFY_SHARED_FLOW_NOT_SCENE_PROMPTS",
    "note": "Prevention improves decisions, not just detects mistakes already produced."
  },
  "concurrency": {
    "policy": "NO_STUDIO_FLOW_CAP",
    "parallelJobs": ">=30_IF_USER_LAUNCHES",
    "wavesCanOverlap": true,
    "specializationsMayRunSimultaneously": true,
    "perJobIndependentBranch": true,
    "perJobPinnedFlow": true,
    "publish": "CAS_AND_ISOLATED_PATHS",
    "notAutonomousBackgroundJobs": true
  },
  "productionTracks": {
    "INTEGRADOR": {
      "scope": "EXISTING_10_COMPLETE_SCENES",
      "preservePrompts": true
    },
    "PERSONAJE": {
      "scope": "10_INDEPENDENT_CHARACTER_STUDIES",
      "noFullGame": true
    },
    "VIDEOJUEGO": {
      "scope": "10_DISTINCT_PLAYABLE_VERTICAL_SLICES",
      "noFullGame": true
    }
  }
}
