{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PROMETEO 3D Preventive Blueprint v1 · preproduction, not late QA",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "sceneId",
    "flowVersion",
    "status",
    "entities",
    "camera",
    "earlyRender"
  ],
  "properties": {
    "schema": {
      "const": "prometeo.3d.preventive-blueprint/v1"
    },
    "sceneId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,60}$"
    },
    "flowVersion": {
      "const": "1.3.0"
    },
    "status": {
      "enum": [
        "PLANNED",
        "SOURCE_VERIFIED",
        "FIRST_ARTICLE_ACCEPTED",
        "SOURCE_ONLY"
      ]
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "visibility",
          "technique",
          "intent",
          "rejectionRisk"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "visibility": {
            "enum": [
              "HERO",
              "CLOSEUP",
              "SUPPORT",
              "BACKGROUND",
              "BLOCKING",
              "TECHNICAL"
            ]
          },
          "technique": {
            "enum": [
              "LICENSED_TEXTURED_ASSET",
              "EDITABLE_MODELED_ASSET",
              "TEXTURED_IMPOSTOR",
              "MECHANICAL_PARAMETRIC",
              "BLOCKOUT_ONLY",
              "RUNTIME_PRIMITIVE_COMPOSITE"
            ]
          },
          "intent": {
            "type": "string"
          },
          "rejectionRisk": {
            "type": "string"
          },
          "closeupAcceptance": {
            "type": "string"
          },
          "firstArticleShot": {
            "type": "string"
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "option",
                "reason"
              ],
              "properties": {
                "option": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          },
          "asset": {
            "type": "object"
          },
          "clearanceContract": {
            "type": "string"
          },
          "assemblyContract": {
            "type": "string"
          },
          "proof": {
            "type": "object",
            "properties": {
              "sourceGitBlob": {
                "type": "string"
              },
              "license": {
                "type": "string"
              },
              "artifactPath": {
                "type": "string"
              },
              "renderRef": {
                "type": "string"
              },
              "renderStatus": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "NOT_RUN"
                ]
              },
              "acceptance": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "STATIC",
            "MOVING",
            "INTERACTIVE",
            "EDITED"
          ]
        },
        "motionPolicy": {
          "const": "CONTINUITY_OR_INTENTIONAL_CUT"
        },
        "beats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "TRAVEL",
                  "HOLD",
                  "CUT"
                ]
              },
              "start": {
                "type": "number"
              },
              "end": {
                "type": "number"
              },
              "startVelocity": {
                "type": "number"
              },
              "endVelocity": {
                "type": "number"
              },
              "motivation": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "earlyRender": {
      "type": "object",
      "required": [
        "targetPlatform",
        "shot",
        "minimumVisible"
      ],
      "properties": {
        "targetPlatform": {
          "type": "string"
        },
        "shot": {
          "type": "string"
        },
        "minimumVisible": {
          "type": "string"
        },
        "renderRef": {
          "type": "string"
        },
        "renderStatus": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        }
      }
    }
  }
}
