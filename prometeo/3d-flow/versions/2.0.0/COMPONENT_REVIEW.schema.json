{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One user-reviewed component assessment per artistic aspect; avoid whole-scene halo effect",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "projectId",
    "flowSha256",
    "briefSha256",
    "entries",
    "artApproval"
  ],
  "properties": {
    "schema": {
      "const": "prometeo.3d.component-review/v2"
    },
    "projectId": {
      "type": "string",
      "minLength": 3
    },
    "flowSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "briefSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artApproval": {
      "enum": [
        "NOT_REVIEWED",
        "PARTIAL_USER_REVIEW",
        "APPROVED_BY_HUMAN",
        "REJECTED_BY_HUMAN"
      ]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "sourceEvidence",
          "userVerdict",
          "observedIssue",
          "relatedStages"
        ],
        "properties": {
          "component": {
            "enum": [
              "HERO",
              "ACTOR",
              "ENVIRONMENT",
              "CAMERA",
              "MATERIAL",
              "LIGHT",
              "INTERACTION",
              "ANIMATION",
              "MECHANICAL",
              "DEPTH",
              "MOBILE",
              "SCOPE"
            ]
          },
          "sourceEvidence": {
            "enum": [
              "SOURCE_READ",
              "CODE_TESTED",
              "WEBGL_CAPTURE",
              "ANDROID_REAL",
              "USER_REPORT_ONLY",
              "NONE"
            ]
          },
          "userVerdict": {
            "enum": [
              "UNREVIEWED",
              "EXCELLENT",
              "GOOD",
              "MIXED",
              "POOR",
              "FAILED",
              "NOT_VISIBLE"
            ]
          },
          "observedIssue": {
            "type": "string"
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "relatedStages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "candidateGeneralization": {
            "type": "string"
          },
          "comparativeReviewProjectId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
