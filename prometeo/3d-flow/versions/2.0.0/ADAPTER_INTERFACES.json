{
  "schema": "prometeo.3d.adapter-interfaces/v2",
  "version": "2.0.0",
  "scope": "STUDIO_3D_ONLY",
  "interfaces": [
    {
      "id": "asset-source",
      "methods": [
        "search(role,style,licenseFilter)",
        "acquire(assetId)"
      ],
      "expectedOutput": "manifest: assetId,sourceUrl,bytesSha256,license,attribution,format,editableSource",
      "status": "RESEARCHED_ONLY",
      "caveat": "Cannot use remote listing as if bytes were downloaded.",
      "requires": [
        "owner",
        "version",
        "sourceRef",
        "licenseOrRights",
        "evidenceLevel"
      ],
      "adapterImplemented": false
    },
    {
      "id": "asset-authoring",
      "methods": [
        "createFromBrief(plan,sourceManifest)",
        "exportEditable(format)"
      ],
      "expectedOutput": "editable project, GLB/FBX if supported, materials, pivots, assetManifest",
      "status": "NOT_CONNECTED",
      "caveat": "Blender/Blockbench tools not installed by mentioning them. No custom renderer.",
      "requires": [
        "owner",
        "version",
        "sourceRef",
        "licenseOrRights",
        "evidenceLevel"
      ],
      "adapterImplemented": false
    },
    {
      "id": "scene-composer",
      "methods": [
        "createScene(scenePlan,assets)",
        "emitSceneDefinition()"
      ],
      "expectedOutput": "world, entity instances, scene hierarchy, nav state, completeness checklist",
      "status": "CONTRACT_DEFINED",
      "caveat": "One canary or only hero is not full scene. Instancing and LOD preserve semantic IDs.",
      "requires": [
        "owner",
        "version",
        "sourceRef",
        "licenseOrRights",
        "evidenceLevel"
      ],
      "adapterImplemented": false
    },
    {
      "id": "renderer",
      "methods": [
        "render(sceneDefinition,rendererConfig)",
        "captureFrame(timecode)"
      ],
      "expectedOutput": "renderer/backend/version, actual pixel frame/recording, errors",
      "status": "OPTIONAL_NOT_INSTALLED",
      "caveat": "Modern Three r163+ supports WebGL2 only. No fake WebGL1.",
      "requires": [
        "owner",
        "version",
        "sourceRef",
        "licenseOrRights",
        "evidenceLevel"
      ],
      "adapterImplemented": false
    },
    {
      "id": "camera",
      "methods": [
        "setMode(GUIDED|FREELOOK|HYBRID|STATIC)",
        "captureShot(timecode,pose)"
      ],
      "expectedOutput": "shotlist rational frames, orbit controls and pose, output frames",
      "status": "CONTRACT_DEFINED",
      "caveat": "Free look user intent cannot be satisfied by a single automated orbit.",
      "requires": [
        "owner",
        "version",
        "sourceRef",
        "licenseOrRights",
        "evidenceLevel"
      ],
      "adapterImplemented": false
    },
    {
      "id": "animation",
      "methods": [
        "bindRigAndClips(actor,clips)",
        "evaluateFrame(timecode)"
      ],
      "expectedOutput": "skeleton binding, root motion, pose, foot contact, action events",
      "status": "CONTRACT_DEFINED",
      "caveat": "No synthetic humanoid cylinders or claiming facial acting absent expressions.",
      "requires": [
        "owner",
        "version",
        "sourceRef",
        "licenseOrRights",
        "evidenceLevel"
      ],
      "adapterImplemented": false
    },
    {
      "id": "material-light-vfx",
      "methods": [
        "applyLook(scene,lookRecipe)",
        "inspectOutput(views)"
      ],
      "expectedOutput": "UV/atlas/PBR, lights, exposure, shadows, fog layer strategy",
      "status": "CONTRACT_DEFINED",
      "caveat": "Don't transfer neon palette to all projects, avoid flat background where parallax expected.",
      "requires": [
        "owner",
        "version",
        "sourceRef",
        "licenseOrRights",
        "evidenceLevel"
      ],
      "adapterImplemented": false
    },
    {
      "id": "media-surface",
      "methods": [
        "attachSurface(mesh,surfaceSource)",
        "input(action)"
      ],
      "expectedOutput": "Texture or video/game state on in-scene mesh, source/content rights, renderer hooks",
      "status": "SOURCE_CANDIDATE_ARCADE",
      "caveat": "Arcade live-surface code works for own signal/radar core, generic user-specified games/media NOT BUILT.",
      "requires": [
        "owner",
        "version",
        "sourceRef",
        "licenseOrRights",
        "evidenceLevel"
      ],
      "adapterImplemented": false
    },
    {
      "id": "runtime-web",
      "methods": [
        "loadModules(assetManifest)",
        "handleError(error,phase)"
      ],
      "expectedOutput": "WebGL2 context/backend, network/asset/module errors, fallback type, context loss state",
      "status": "SOURCE_HELPER_ONLY",
      "caveat": "Render requires actual browser and hardware; fallback must clearly say it is 2D.",
      "requires": [
        "owner",
        "version",
        "sourceRef",
        "licenseOrRights",
        "evidenceLevel"
      ],
      "adapterImplemented": false
    },
    {
      "id": "publisher",
      "methods": [
        "publishCandidate(bundle,branchLease)",
        "readbackPreview(url)"
      ],
      "expectedOutput": "Git commit/tree/QA, scoped path, HTTPS verification when available",
      "status": "GITHUB_CONNECTOR_AVAILABLE",
      "caveat": "Do not write other project branches; do not claim HTTP verified from Git commit.",
      "requires": [
        "owner",
        "version",
        "sourceRef",
        "licenseOrRights",
        "evidenceLevel"
      ],
      "adapterImplemented": false
    },
    {
      "id": "qa-evidence",
      "methods": [
        "collect(scene,phase)",
        "reportComponent(component,verdict)"
      ],
      "expectedOutput": "source tests, rendered pixels, mobile results or NOT_RUN flags per component",
      "status": "SOURCE_HELPER_ONLY",
      "caveat": "No artistic veto and no visual approval without user.",
      "requires": [
        "owner",
        "version",
        "sourceRef",
        "licenseOrRights",
        "evidenceLevel"
      ],
      "adapterImplemented": false
    },
    {
      "id": "review-learning",
      "methods": [
        "ingestUserReview(projectId,component,comment)",
        "proposeFlowDelta()"
      ],
      "expectedOutput": "stage linked issue, generalized next-flow proposal, second consumer test",
      "status": "SOURCE_HELPER_ONLY",
      "caveat": "Never edit same brief or flow mid-wave, no automatic chat communication.",
      "requires": [
        "owner",
        "version",
        "sourceRef",
        "licenseOrRights",
        "evidenceLevel"
      ],
      "adapterImplemented": false
    }
  ],
  "dataFlow": [
    [
      "human-brief",
      "scene-composer",
      "BRIEF_LOCK+COMPILED_PLAN"
    ],
    [
      "asset-source",
      "asset-authoring",
      "source+hash+rights"
    ],
    [
      "asset-authoring",
      "scene-composer",
      "editable/GLB/rig/UV"
    ],
    [
      "scene-composer",
      "material-light-vfx",
      "world/entities"
    ],
    [
      "scene-composer",
      "animation",
      "actors+timeline"
    ],
    [
      "scene-composer",
      "camera",
      "shots/navigation"
    ],
    [
      "media-surface",
      "scene-composer",
      "texture+input state"
    ],
    [
      "material-light-vfx",
      "renderer",
      "final scene materials"
    ],
    [
      "camera",
      "renderer",
      "camera poses"
    ],
    [
      "renderer",
      "qa-evidence",
      "actual captured frames or NOT_RUN"
    ],
    [
      "scene-composer",
      "runtime-web",
      "ES modules/assets"
    ],
    [
      "runtime-web",
      "publisher",
      "candidate run bundles"
    ],
    [
      "publisher",
      "review-learning",
      "preview+user review after delivery"
    ]
  ],
  "responsibility": "The host agent uses only connected adapters; an interface specification does not mean app is connected or tool ran. Mandatory goal remains full effort/product."
}
