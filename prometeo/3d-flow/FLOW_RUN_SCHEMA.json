{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prometeo.3d.flow-run/v1",
  "type": "object",
  "required": [
    "schema",
    "creationId",
    "flow",
    "status",
    "nodeResults",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "prometeo.3d.flow-run/v1"
    },
    "creationId": {
      "type": "string",
      "minLength": 1
    },
    "flow": {
      "type": "object",
      "required": [
        "id",
        "version",
        "sha256Canonical"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sha256Canonical": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "status": {
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "BLOCKED",
        "CANDIDATE",
        "READY_FOR_ART_REVIEW",
        "VERIFIED"
      ]
    },
    "nodeResults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nodeId",
          "status"
        ],
        "properties": {
          "nodeId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceSha": {
            "type": [
              "string",
              "null"
            ]
          },
          "method": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "sourceRepo",
        "sourceRef",
        "sourceCommit"
      ],
      "properties": {
        "sourceRepo": {
          "type": "string"
        },
        "sourceRef": {
          "type": "string"
        },
        "sourceCommit": {
          "type": "string",
          "minLength": 7
        }
      }
    },
    "artApproval": {
      "enum": [
        "NOT_REVIEWED",
        "APPROVED",
        "REJECTED"
      ]
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "publicHTTPVerified": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
